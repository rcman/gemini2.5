function updateAnimals(deltaTime) {
    // Iterate scene.meshes, find metadata.type === 'animal'
    // Update AI state machine (idle, roam, flee, attack)
    // Move animal mesh based on state and deltaTime
    // Play corresponding animations
}

function attackAnimal(animalMesh) {
     const meta = animalMesh.metadata;
     if (!meta || meta.isDead) return;

     const heldItem = getHeldItem();
     const weaponDamage = (heldItem && items[heldItem.id]?.tool === 'knife') ? 25 : (heldItem && items[heldItem.id]?.tool === 'axe') ? 15 : 5;

     if (!heldItem || !items[heldItem.id]?.tool) { // Check if holding a tool at all
         logMessage("Need a weapon/tool to attack.");
         return;
     }

     meta.health -= weaponDamage;
     logMessage(`Attacked ${meta.species || 'Animal'}, health: ${meta.health}`);
     // Play attack sound/animation, animal hit sound/animation

     if (meta.health <= 0) {
         logMessage(`${meta.species || 'Animal'} killed!`);
         meta.isDead = true; meta.health = 0;
         // Stop AI, play death animation, disable collisions?
         // animalMesh.checkCollisions = false;
     } else {
         meta.state = 'flee'; // Trigger flee AI state
     }
}

function harvestAnimal(animalMesh) {
     const meta = animalMesh.metadata;
     if (!meta || !meta.isDead || meta.harvested) return;

     const heldItem = getHeldItem();
      if (!heldItem || items[heldItem.id]?.tool !== 'knife') {
         logMessage(`Need a knife to harvest.`);
         return;
     }

     logMessage(`Harvesting ${meta.species || 'Animal'}...`);
     let harvestedSomething = false;
     if (meta.drops) {
         for (const itemId in meta.drops) {
             const quantity = Math.floor(Math.random() * meta.drops[itemId]) + 1;
             if (quantity > 0 && addItemToInventory(itemId, quantity)) {
                 harvestedSomething = true; // Successfully added *some* loot
             }
         }
     }

     if (harvestedSomething) {
        meta.harvested = true;
        logMessage(`Harvested.`);
        // Dispose corpse after delay
        setTimeout(() => { if (animalMesh) animalMesh.dispose(); }, 15000);
        if (highlightedMesh === animalMesh) { highlightedMesh = null; showInteractionPrompt(false); }
     } else {
         logMessage(`Nothing useful recovered.`);
         meta.harvested = true; // Mark as harvested attempt
         setTimeout(() => { if (animalMesh) animalMesh.dispose(); }, 5000); // Dispose quicker if empty
     }
}


// --- Utility Functions ---
function getHeldItem() {
    // Get item from the currently selected quick bar slot
    if (activeQuickBarIndex >= 0 && activeQuickBarIndex < quickBar.length) {
        return quickBar[activeQuickBarIndex];
    }
    return null;
}

function logMessage(message, duration = 3500) {
    // console.log("LOG:", message); // Keep for debugging if needed
    const msgDiv = document.createElement('div');
    msgDiv.textContent = message;
    messageLog.appendChild(msgDiv);

    // Limit number of messages shown
     const maxMessages = 5;
     while(messageLog.children.length > maxMessages) {
         messageLog.removeChild(messageLog.firstChild);
     }

    // Remove the message after a delay + fade
    const fadeOutTimer = setTimeout(() => {
        msgDiv.style.opacity = '0';
        msgDiv.style.transition = 'opacity 0.5s ease-out';
        setTimeout(() => {
            if (msgDiv.parentNode === messageLog) { messageLog.removeChild(msgDiv); }
        }, 500); // Match CSS transition duration
    }, duration);
}


// --- Main Render Loop ---
let lastFrameTime = Date.now();
function renderLoop() {
    if (!scene || !engine) return; // Exit if scene/engine not ready

    const currentTime = Date.now();
    const deltaTime = (currentTime - lastFrameTime) / 1000.0; // Delta time in seconds
    lastFrameTime = currentTime;

    // Only process game logic if game is not paused by UI
    if (!isInventoryOpen && !isCraftingOpen && !isLootOpen) {
         // Handle player input for movement & look
         handlePlayerMovement(deltaTime);

         // Handle interactions
         castRay();
         handleInteraction(); // Checks inputMap["e"]

         // Handle placing items
         handlePlacing(); // Checks inputMap["p"]

         // Update game world logic
         // updateAnimals(deltaTime); // Placeholder
         // updateWorldTimers(deltaTime); // Placeholder for cooking etc.
    } else {
         // Game is paused - perhaps update UI animations?
    }

    // Render the scene
    scene.render();
}


// --- Game Initialization ---
async function startGame() {
    logMessage("Initializing game...", 5000);
    try {
        // Ensure canvas is visible and sized correctly
        canvas.style.width = '100%';
        canvas.style.height = '100%';

        scene = await createScene(); // Create the scene and its objects

        // Event Listeners for UI Buttons
        closeInventoryBtn.onclick = () => toggleInventory(false);
        closeCraftingBtn.onclick = () => toggleCraftingMenu(false);
        closeLootBtn.onclick = closeLootContainer;

        // Set initial active quickbar slot visual
        setActiveQuickBarSlot(0);

        // Start the render loop using engine.runRenderLoop
        engine.runRenderLoop(renderLoop);
        logMessage("Game started!", 5000);

        // Watch for browser/canvas resize events
        window.addEventListener('resize', () => {
            engine.resize();
        });

    } catch (error) {
        console.error("Error starting game:", error);
        logMessage(`FATAL ERROR: ${error.message}. Check console (F12).`, 60000);
        // Display error prominently on screen
         const errorDiv = document.createElement('div');
         errorDiv.style.cssText = `position: absolute; top: 10px; left: 10px; padding: 15px; background-color: #8B0000; color: white; z-index: 100; border: 2px solid red; font-family: sans-serif; font-size: 1.1em;`;
         errorDiv.textContent = `ERROR INITIALIZING GAME: ${error.message}. See console (F12) for details.`;
         document.body.appendChild(errorDiv);
         // Stop any potential loop if engine was started somehow
         if (engine) engine.stopRenderLoop();
    }
}

// --- Run the Game ---
// Use DOMContentLoaded to ensure HTML is ready before starting Babylon
document.addEventListener('DOMContentLoaded', () => {
    if (BABYLON.Engine.isSupported()) {
        startGame();
    } else {
        alert('Babylon.js is not supported on your browser!');
    }
});
