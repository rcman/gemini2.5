function fillCanteen(waterMesh) {
     const canteenInfo = findInventoryItem('canteen');
     if (canteenInfo) {
         const theCanteen = canteenInfo.item;
         if (!theCanteen.contains || theCanteen.contains.id !== 'water_dirty') {
             theCanteen.contains = { id: 'water_dirty', quantity: 1 };
             logMessage("Filled canteen with dirty water.");
             updateInventoryUI(); updateQuickBarUI();
         } else {
             logMessage("Canteen already contains dirty water.");
         }
     } else {
         logMessage("You need a canteen to collect water.");
     }
}

// --- Central Timer Update Loop (Placeholder) ---
function updateWorldTimers(deltaTime) {
    // Iterate through all placed campfires, forges etc. in the scene
    // Find meshes with metadata.type === 'placed_object'
    scene.meshes.forEach(mesh => {
        if (mesh.metadata?.type === 'placed_object' && mesh.isEnabled()) {
            const meta = mesh.metadata;
            // Campfire Logic
            if (meta.originalItemId === 'campfire' && meta.isLit) {
                meta.fuel -= deltaTime * 0.1; // Fuel consumption rate
                if (meta.fuel <= 0) { meta.isLit = false; meta.fuel = 0; logMessage("Campfire went out."); /* Turn off particle effect */ }

                // Update cooking slots
                meta.cookingSlots?.forEach((slot, index) => {
                    if (slot && slot.itemId === 'raw_meat') { // Check if ready
                         slot.cookTime += deltaTime;
                         if (slot.cookTime >= slot.cookDuration) {
                             logMessage("Meat cooked!");
                             slot.itemId = 'cooked_meat'; // Change item in slot
                             // Maybe add visual change?
                         }
                    } else if (slot && slot.itemId === 'canteen' && slot.content === 'water_dirty') {
                         // Boiling water in canteen
                         slot.cookTime += deltaTime;
                         if (slot.cookTime >= slot.cookDuration) {
                              logMessage("Water boiled!");
                              slot.content = 'water_clean';
                              // Find the actual canteen item in player inv/qb and update its .contains prop? Complex linking.
                              // Easier: Player retrieves canteen, its state is updated then.
                         }
                    }
                });
            }
            // Forge Logic
            else if (meta.originalItemId === 'forge' && meta.isLit) {
                 meta.fuel -= deltaTime * 0.2; // Forge uses more fuel
                 if (meta.fuel <= 0) { meta.isLit = false; meta.fuel = 0; logMessage("Forge went out."); }

                 // Update smelting slot
                 if (meta.smeltingSlot && meta.smeltingSlot.itemId === 'scrap_metal') {
                      meta.smeltingSlot.smeltTime += deltaTime;
                      if (meta.smeltingSlot.smeltTime >= meta.smeltingSlot.smeltDuration) {
                          logMessage("Metal smelted!");
                          // Add to output buffer or slot
                          if (!meta.outputSlot) meta.outputSlot = { itemId: 'metal_ingot', quantity: 0 };
                          meta.outputSlot.quantity += 1; // Or based on recipe
                          meta.smeltingSlot = null; // Clear input slot
                      }
                 }
            }
        }
    });
}


